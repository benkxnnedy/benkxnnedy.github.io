---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const { title, summary, date, tags = [], type = 'Post', status } = frontmatter;
const sectionPath = '/posts';
const sectionLabel = 'Posts';
const displayDate = date ? new Date(date).toLocaleDateString('en-GB', { year:'numeric', month:'long', day:'numeric' }) : '';
---
<BaseLayout title={`${title} — Ben Kennedy`} description={summary}>
  <main class="article-wrap">
    <a class="back-link" href={sectionPath}>← Back to {sectionLabel}</a>
    <header class="article-header">
      <div class="eyebrow" style="margin-top:26px">{type}</div>
      <h1>{title}</h1>
      {summary && <p class="article-summary">{summary}</p>}
      <div class="article-meta">
        {displayDate && <span>{displayDate}</span>}
        {status && <span>· {status}</span>}
      </div>
      {tags.length > 0 && <div class="tags">{tags.map(tag => <span class="tag">{tag}</span>)}</div>}
    </header>
    <article class="prose"><slot /></article>
  </main>
</BaseLayout>
