---
import BaseLayout from '../../layouts/BaseLayout.astro';
const modules = import.meta.glob('./*.md', { eager: true });
const posts = Object.entries(modules).map(([path, mod]) => ({ ...mod.frontmatter, slug: path.split('/').pop().replace('.md','') })).sort((a,b) => new Date(b.date ?? 0) - new Date(a.date ?? 0));
const fmt = (d) => d ? new Date(d).toLocaleDateString('en-GB', { month:'short', year:'numeric' }) : 'Draft';
---
<BaseLayout title="CCIE Journal — Ben Kennedy">
  <main><div class="container page-hero"><div class="eyebrow">CCIE Journal</div><h1>A public record of the work behind the number.</h1><p>Technical problems, labs and troubleshooting lessons from the CCIE Enterprise Infrastructure journey. Posts are plain Markdown files stored in this repository.</p></div>
  <section class="section"><div class="container timeline">{posts.map(p => <div class="timeline-item"><div class="date">{fmt(p.date)}</div><div><h3><a href={`/ccie-journal/${p.slug}`}>{p.title}</a></h3><p class="muted">{p.summary}</p><div class="tags">{(p.tags ?? []).map(t => <span class="tag">{t}</span>)}</div></div></div>)}</div></section></main>
</BaseLayout>
